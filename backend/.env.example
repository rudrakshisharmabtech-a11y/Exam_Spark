NODE_ENV=development
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:8443
API_PROXY_TARGET=http://localhost:3001

# JWT Secret (at least 32 characters)
JWT_SECRET=examspark-super-secure-production-ready-jwt-key-32chars
JWT_TTL=8h

# ========================================================
# LIVE DATABASE (RAILWAY MySQL or LOCAL MySQL)
# ========================================================
# Option 1: Railway MySQL connection URL (recommended)
# When you create a MySQL service on Railway, copy the MySQL Connection URL:
DATABASE_URL=
# or
MYSQL_URL=

# Option 2: Individual variables (standard or Railway format)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=examspark
DB_POOL_SIZE=10

# ========================================================
# GOOGLE OAUTH AUTHENTICATION
# ========================================================
# Get these from Google Cloud Console (APIs & Services > Credentials):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# GITHUB OAUTH (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# ========================================================
# ADVANCED AI FEATURES (SMART AI SUMMARIZER & PDF CHAT)
# ========================================================
# Works out of the box with built-in NLP engine!
# To enable OpenAI or Gemini API, set your API key:
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=whisper-1

# Optional initial admin credentials:
BOOTSTRAP_ADMIN_NAME=Admin User
BOOTSTRAP_ADMIN_EMAIL=admin@examspark.internal
BOOTSTRAP_ADMIN_PASSWORD=AdminPassword123!
