NODE_ENV=development
API_PORT=3001
FRONTEND_ORIGIN=http://localhost:8443
API_PROXY_TARGET=http://localhost:3001

# Set a unique secret of at least 32 characters before starting the API.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_TTL=8h

DB_HOST=localhost
DB_PORT=3306
DB_USER=examspark_app
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=examspark
DB_POOL_SIZE=10

# Supabase Auth project settings. The anon key is intended for browser use;
# never put a Supabase service-role key in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# OAuth callbacks must exactly match the URLs registered with Google and GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback

# AI tools use an OpenAI-compatible API. Keep the key server-side.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TRANSCRIPTION_MODEL=whisper-1

# Only used once by `pnpm bootstrap:admin`; remove these after the first admin is created.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
